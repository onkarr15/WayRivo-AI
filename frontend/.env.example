# ===================================================================
# WayRivo AI 2.0 - Frontend Environment Variables
# ===================================================================
# In local development: Leave unset or comment out to use Vite dev proxy (/api -> http://localhost:8085)
# In production on Vercel: Set in Vercel Project Settings -> Environment Variables

# The deployed Render backend API URL (Direct or via /api proxy)
# Example: https://your-render-backend-name.onrender.com/api
# Or leave unset to rely on Vercel's rewrite rule in vercel.json
VITE_API_BASE_URL=https://your-backend-service.onrender.com/api

