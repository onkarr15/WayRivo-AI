# ==============================================================================
# WayRivo AI 2.0 Backend Environment Configuration Example
# Copy this file to .env and configure your real secrets.
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=8085
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL / Supabase)
# For Supabase Session Pooling (Port 5432):
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection for Prisma Migrations (Port 5432):
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_64_characters_2026!
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# PayPal Developer Sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Google Gemini AI Logic
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
