datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  USER
  TRAVELER
  EXPERT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  ESCROW_HOLD
  ESCROW_RELEASED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  APPROVED
  CAPTURED
  ESCROW_LOCKED
  RELEASED
  REFUNDED
  FAILED
}

enum EscrowStatus {
  HELD
  DISBURSED
  REFUNDED
}

enum BookingItemType {
  HOTEL
  ACTIVITY
  PACKAGE
  CUSTOM
}

enum ItineraryStatus {
  DRAFT
  PROPOSED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum MessageSender {
  USER
  ASSISTANT
  SYSTEM
}

enum GroupTripStatus {
  PLANNING
  LOCKED
  COMPLETED
}

enum SplitMethod {
  EQUAL
  PERCENTAGE
  EXACT
}

enum AgentActionType {
  SEARCH_INVENTORY
  OPTIMIZE_BUDGET
  GENERATE_ITINERARY
  VERIFY_ESCROW
  CREATE_BOOKING
}

enum AgentActionStatus {
  SUCCESS
  FAILED
}

// -------------------------------------------------------------
// 1. USER
// -------------------------------------------------------------
model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String
  name          String
  role          UserRole     @default(TRAVELER)
  phone         String?
  avatarUrl     String?
  status                 UserStatus   @default(ACTIVE)
  isEmailVerified        Boolean      @default(false)
  emailVerificationToken String?
  passwordResetToken     String?
  passwordResetExpires   DateTime?

  // Extended Profile Preferences
  preferredDestinations  String[]     @default([])
  travelInterests        String[]     @default([])
  budgetPreference       String?      @default("Moderate")
  preferredCurrency      String       @default("INR")

  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  // Relations
  bookings      Booking[]
  itineraries   Itinerary[]
  conversations Conversation[]
  groupTrips    GroupTrip[]    @relation("OrganizerTrips")
  paidExpenses  GroupExpense[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([role])
}

// -------------------------------------------------------------
// 2. DESTINATION
// -------------------------------------------------------------
model Destination {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  country         String         @default("India")
  state           String?
  description     String         @db.Text
  imageUrl        String
  bestTimeToVisit String?
  averageBudget   Decimal        @default(25000.00) @db.Decimal(10, 2)
  currency        String         @default("INR")
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  hotels          Hotel[]
  activities      Activity[]
  packages        TravelPackage[]
  itineraries     Itinerary[]

  @@index([slug])
  @@index([country, state])
}

// -------------------------------------------------------------
// 3. HOTEL
// -------------------------------------------------------------
model Hotel {
  id             String       @id @default(cuid())
  destinationId  String
  name           String
  description    String       @db.Text
  address        String
  city           String
  stars          Int          @default(3)
  pricePerNight  Decimal      @db.Decimal(10, 2)
  currency       String       @default("INR")
  amenities      String[]
  imageUrls      String[]
  contactEmail   String?
  contactPhone   String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  destination    Destination  @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
  @@index([stars])
}

// -------------------------------------------------------------
// 4. ACTIVITY
// -------------------------------------------------------------
model Activity {
  id             String       @id @default(cuid())
  destinationId  String
  title          String
  description    String       @db.Text
  category       String
  durationHours  Decimal      @db.Decimal(4, 1)
  pricePerPerson Decimal      @db.Decimal(10, 2)
  currency       String       @default("INR")
  location       String?
  imageUrls      String[]
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  destination    Destination  @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
  @@index([category])
}

// -------------------------------------------------------------
// 5. TRAVEL PACKAGE
// -------------------------------------------------------------
model TravelPackage {
  id                 String       @id @default(cuid())
  destinationId      String
  title              String
  description        String       @db.Text
  durationDays       Int          @default(5)
  totalPrice         Decimal      @db.Decimal(10, 2)
  pricePerPerson     Decimal      @db.Decimal(10, 2)
  currency           String       @default("INR")
  inclusions         String[]
  exclusions         String[]
  cancellationPolicy String       @db.Text
  isRecommended      Boolean      @default(false)
  expertName         String
  organizationName   String
  expertRating       Decimal      @default(4.8) @db.Decimal(2, 1)
  expertReviews      Int          @default(12)
  imageUrl           String?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Relations
  destination        Destination  @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
  @@index([isRecommended])
}

// -------------------------------------------------------------
// 6. CONVERSATION
// -------------------------------------------------------------
model Conversation {
  id           String              @id @default(cuid())
  userId       String
  title        String              @default("Trip Planning Session")
  status       ConversationStatus  @default(ACTIVE)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  // Relations
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     Message[]
  agentActions AgentAction[]

  @@index([userId])
}

// -------------------------------------------------------------
// 7. MESSAGE
// -------------------------------------------------------------
model Message {
  id             String         @id @default(cuid())
  conversationId String
  sender         MessageSender  @default(USER)
  content        String         @db.Text
  metadata       Json?
  createdAt      DateTime       @default(now())

  // Relations
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// -------------------------------------------------------------
// 8. ITINERARY
// -------------------------------------------------------------
model Itinerary {
  id                 String           @id @default(cuid())
  userId             String
  destinationId      String
  title              String
  travelStyle        String?
  startDate          DateTime?
  endDate            DateTime?
  numberOfDays       Int              @default(5)
  travelersCount     Int              @default(2)
  budget             Decimal          @db.Decimal(10, 2)
  currency           String           @default("INR")
  status             ItineraryStatus  @default(DRAFT)
  totalEstimatedCost Decimal          @default(0.00) @db.Decimal(10, 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Relations
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination        Destination      @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  days               ItineraryDay[]
  booking            Booking?

  @@index([userId])
  @@index([destinationId])
}

// -------------------------------------------------------------
// 9. ITINERARY DAY
// -------------------------------------------------------------
model ItineraryDay {
  id                 String     @id @default(cuid())
  itineraryId        String
  dayNumber          Int
  date               DateTime?
  title              String
  description        String     @db.Text
  mealsIncluded      String[]
  accommodationNotes String?    @db.Text
  activitiesNotes    String?    @db.Text
  estimatedDayCost   Decimal    @default(0.00) @db.Decimal(10, 2)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Relations
  itinerary          Itinerary  @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@unique([itineraryId, dayNumber])
  @@index([itineraryId])
}

// -------------------------------------------------------------
// 10. BOOKING
// -------------------------------------------------------------
model Booking {
  id                String         @id @default(cuid())
  bookingReference  String         @unique
  userId            String
  itineraryId       String?        @unique
  status            BookingStatus  @default(PENDING_PAYMENT)
  totalAmount       Decimal        @db.Decimal(10, 2)
  currency          String         @default("INR")
  specialRequests   String?        @db.Text
  escrowReleaseDate DateTime?
  confirmedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Relations
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  itinerary         Itinerary?     @relation(fields: [itineraryId], references: [id], onDelete: SetNull)
  items             BookingItem[]
  payment           Payment?

  @@index([userId])
  @@index([status])
  @@index([bookingReference])
}

// -------------------------------------------------------------
// 11. BOOKING ITEM
// -------------------------------------------------------------
model BookingItem {
  id          String           @id @default(cuid())
  bookingId   String
  itemType    BookingItemType  @default(CUSTOM)
  referenceId String?
  title       String
  unitPrice   Decimal          @db.Decimal(10, 2)
  quantity    Int              @default(1)
  totalPrice  Decimal          @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime         @default(now())

  // Relations
  booking     Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// -------------------------------------------------------------
// 12. PAYMENT
// -------------------------------------------------------------
model Payment {
  id              String        @id @default(cuid())
  bookingId       String        @unique
  paypalOrderId   String        @unique
  paypalCaptureId String?       @unique
  status          PaymentStatus @default(CREATED)
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("INR")
  payerEmail      String?
  payerName       String?
  payerId         String?
  escrowStatus    EscrowStatus  @default(HELD)
  idempKey        String?       @unique
  captureData     Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([paypalOrderId])
  @@index([paypalCaptureId])
  @@index([status])
  @@index([idempKey])
}

// -------------------------------------------------------------
// 13. GROUP TRIP
// -------------------------------------------------------------
model GroupTrip {
  id           String           @id @default(cuid())
  organizerId  String
  title        String
  destinationId String?
  inviteCode   String           @unique
  targetBudget Decimal          @default(0.00) @db.Decimal(10, 2)
  currency     String           @default("INR")
  status       GroupTripStatus  @default(PLANNING)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Relations
  organizer    User             @relation("OrganizerTrips", fields: [organizerId], references: [id], onDelete: Cascade)
  expenses     GroupExpense[]

  @@index([organizerId])
  @@index([inviteCode])
}

// -------------------------------------------------------------
// 14. GROUP EXPENSE
// -------------------------------------------------------------
model GroupExpense {
  id          String       @id @default(cuid())
  groupTripId String
  paidById    String
  amount      Decimal      @db.Decimal(10, 2)
  currency    String       @default("INR")
  description String
  category    String       @default("General")
  splitMethod SplitMethod  @default(EQUAL)
  receiptUrl  String?
  createdAt   DateTime     @default(now())

  // Relations
  groupTrip   GroupTrip    @relation(fields: [groupTripId], references: [id], onDelete: Cascade)
  paidBy      User         @relation(fields: [paidById], references: [id], onDelete: Cascade)

  @@index([groupTripId])
  @@index([paidById])
}

// -------------------------------------------------------------
// 15. AGENT ACTION
// -------------------------------------------------------------
model AgentAction {
  id             String            @id @default(cuid())
  conversationId String
  actionType     AgentActionType
  toolInput      Json
  toolOutput     Json
  executionMs    Int               @default(0)
  status         AgentActionStatus @default(SUCCESS)
  createdAt      DateTime          @default(now())

  // Relations
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([actionType])
}

// -------------------------------------------------------------
// 16. AUDIT LOG
// -------------------------------------------------------------
model AuditLog {
  id         String    @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  // Relations
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
}
